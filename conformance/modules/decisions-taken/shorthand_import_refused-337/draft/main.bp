//// Decision 337 — The shorthand import goes; `mod m;` binds the namespace `m` in the module that declares it.

import {io.terminal} from "std";
import {url_rules.PathRules, url_rules.canonicalize} from "routing";
import {links.href};

pub fn main() -> void {
    val link = href("/guides/getting started");
    terminal.print(link);
    terminal.print(
        canonicalize(PathRules(basePath: "/docs", trailingSlash: false), link),
    );
}
